# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 13

# Theme
theme = tokyonight

# Window
window-padding-x = 12
window-padding-y = 12
background-opacity = 0.95

# Shell
shell-integration = fish

# Cursor
cursor-style = bar
cursor-style-blink = true

# Keybindings
keybind = cmd+t=new_tab
keybind = cmd+w=close_surface
keybind = cmd+enter=toggle_fullscreen
